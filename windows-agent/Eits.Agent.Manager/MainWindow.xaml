<Window x:Class="Eits.Agent.Manager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EITS Agent Manager" Icon="Assets/eits-agent-icon.ico"
        Width="1080" Height="780" MinWidth="920" MinHeight="700"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" Background="#06111F">
    <Grid>
        <Grid.Background>
            <RadialGradientBrush Center="0.08,0.04" GradientOrigin="0.08,0.04" RadiusX="0.95" RadiusY="1.05">
                <GradientStop Color="#163653" Offset="0"/><GradientStop Color="#081725" Offset="0.47"/><GradientStop Color="#040C17" Offset="1"/>
            </RadialGradientBrush>
        </Grid.Background>

        <Canvas IsHitTestVisible="False" Opacity="0.17">
            <Line X1="0" Y1="146" X2="1040" Y2="146" Stroke="#49A6FF" StrokeThickness="1"/>
            <Line X1="690" Y1="0" X2="1040" Y2="350" Stroke="#45E6D4" StrokeThickness="1"/>
            <Ellipse Width="410" Height="410" Canvas.Left="785" Canvas.Top="-230" Stroke="#45E6D4" StrokeThickness="1"/>
            <Ellipse Width="300" Height="300" Canvas.Left="840" Canvas.Top="-175" Stroke="#49A6FF" StrokeThickness="1"/>
        </Canvas>

        <Grid Margin="38,28,38,32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="18"/><RowDefinition Height="190"/>
                <RowDefinition Height="16"/><RowDefinition Height="124"/><RowDefinition Height="16"/><RowDefinition Height="*" MinHeight="250"/>
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Width="82" Height="82" CornerRadius="22" Background="#10253B" BorderBrush="#396887" BorderThickness="1" Padding="8">
                    <Image Source="Assets/eits-agent-icon.png" Stretch="Uniform"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="20,5,0,0">
                    <TextBlock Text="EITS MONITOR" Style="{StaticResource SectionLabel}"/>
                    <TextBlock Text="Agent Command Center" FontSize="31" FontWeight="SemiBold" Margin="0,4,0,0"/>
                    <TextBlock Text="Secure telemetry link and Windows service control" Foreground="{StaticResource SecondaryTextBrush}" FontSize="14" Margin="0,3,0,0"/>
                </StackPanel>
                <Border Grid.Column="2" VerticalAlignment="Center" CornerRadius="18" Background="#111F32" BorderBrush="#29445E" BorderThickness="1" Padding="16,9">
                    <StackPanel Orientation="Horizontal"><Ellipse x:Name="HeaderStatusDot" Width="8" Height="8" Fill="#64748B" Margin="0,0,9,0"/><TextBlock x:Name="HeaderStatusText" Text="SCANNING" FontSize="11" FontWeight="Bold" Foreground="{StaticResource SecondaryTextBrush}"/></StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="0.9*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="1.45*"/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Text="SERVICE CORE" Style="{StaticResource SectionLabel}"/>
                        <StackPanel Grid.Row="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal"><Ellipse x:Name="StatusDot" Width="12" Height="12" Fill="#64748B" Margin="0,2,12,0"/><TextBlock x:Name="ServiceStateText" Text="Checking..." FontSize="30" FontWeight="SemiBold"/></StackPanel>
                            <TextBlock x:Name="RegistrationText" Foreground="{StaticResource SecondaryTextBrush}" FontSize="13" Margin="24,7,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Orientation="Horizontal"><TextBlock Text="NODE  " Foreground="#607D9B" FontSize="11" FontWeight="Bold"/><TextBlock x:Name="DeviceText" FontSize="12" FontWeight="SemiBold"/></StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Text="UPLINK" Style="{StaticResource SectionLabel}"/>
                        <StackPanel Grid.Row="1" VerticalAlignment="Center">
                            <TextBlock Text="DESTINATION SERVER" Foreground="#607D9B" FontSize="10" FontWeight="Bold"/>
                            <TextBlock x:Name="ServerText" FontSize="18" FontWeight="SemiBold" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="Encrypted outbound telemetry channel" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" Margin="0,5,0,0"/>
                        </StackPanel>
                        <Button Grid.Row="2" Content="Configure uplink" Style="{StaticResource TechButton}" HorizontalAlignment="Left" Margin="0" Click="ChangeConnection_Click"/>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="4" Style="{StaticResource CardStyle}" Padding="22,18">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Width="42" Height="42" CornerRadius="12" Background="#12304A" VerticalAlignment="Center"><TextBlock Text="⌁" Foreground="{StaticResource AccentBrush}" FontSize="25" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center"><TextBlock Text="LATEST TELEMETRY EVENT" Style="{StaticResource SectionLabel}"/><TextBlock x:Name="ActivityText" Text="Awaiting agent activity..." TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Foreground="#C8D8E8" Margin="0,8,0,0"/></StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="6">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.32*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="0.9*"/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="18"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Text="SERVICE OPERATIONS" Style="{StaticResource SectionLabel}"/>
                        <TextBlock Grid.Row="1" Text="Control the Windows monitoring service" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,7,0,0"/>
                        <UniformGrid Grid.Row="3" Columns="4">
                            <Button Content="Refresh" Style="{StaticResource TechButton}" Click="Refresh_Click"/>
                            <Button Content="Start" Style="{StaticResource AccentButton}" Click="Start_Click"/>
                            <Button Content="Stop" Style="{StaticResource TechButton}" Click="Stop_Click"/>
                            <Button Content="Restart" Style="{StaticResource TechButton}" Margin="0" Click="Restart_Click"/>
                        </UniformGrid>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardStyle}" MinHeight="250">
                    <StackPanel>
                        <TextBlock Text="QUICK ACCESS" Style="{StaticResource SectionLabel}"/>
                        <TextBlock Text="Agent tools and diagnostics" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,7,0,14"/>
                        <StackPanel>
                            <Button Content="Launch dashboard  ↗" Style="{StaticResource AccentButton}" Margin="0,0,0,8" Click="Dashboard_Click"/>
                            <Button Content="View diagnostic log" Style="{StaticResource TechButton}" Margin="0,0,0,8" Click="Logs_Click"/>
                            <Button Content="Open agent data" Style="{StaticResource TechButton}" Margin="0" Click="Data_Click"/>
                        </StackPanel>
                        <TextBlock Text="UPDATE CHANNEL  •  MANUAL" Foreground="#607D9B" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,14,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
