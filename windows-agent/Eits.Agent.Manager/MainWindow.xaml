<Window x:Class="Eits.Agent.Manager.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="EITS Agent Manager" Width="920" Height="650" MinWidth="800" MinHeight="580" WindowStartupLocation="CenterScreen" Background="#F4F7FA" FontFamily="Segoe UI">
  <Window.Resources>
    <Style TargetType="Button"><Setter Property="Height" Value="38"/><Setter Property="Padding" Value="16,6"/><Setter Property="Margin" Value="4"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#CBD5E1"/><Setter Property="Cursor" Value="Hand"/></Style>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#223044"/></Style>
    <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#DCE3EA"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="20"/><Setter Property="Margin" Value="0,0,12,12"/></Style>
  </Window.Resources>
  <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel Margin="4,0,0,24"><TextBlock Text="EITS Agent Manager" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="Windows monitoring service and device connectivity" Foreground="#64748B" FontSize="14"/></StackPanel>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width=".9*"/><ColumnDefinition Width="1.4*"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="SERVICE" Foreground="#64748B" FontWeight="SemiBold"/><TextBlock x:Name="ServiceStateText" Text="Checking…" FontSize="28" FontWeight="SemiBold" Margin="0,8"/><TextBlock x:Name="RegistrationText"/><TextBlock x:Name="DeviceText" Margin="0,4,0,0"/></StackPanel></Border>
      <Border Grid.Column="1" Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="CONNECTION" Foreground="#64748B" FontWeight="SemiBold"/><TextBlock Grid.Row="1" x:Name="ServerText" Margin="0,10" FontSize="15"/><Button Grid.Row="2" Content="Change connection" HorizontalAlignment="Left" Click="ChangeConnection_Click"/></Grid></Border>
    </Grid>
    <Border Grid.Row="2" Style="{StaticResource Card}"><StackPanel><TextBlock Text="LATEST ACTIVITY" Foreground="#64748B" FontWeight="SemiBold"/><TextBlock x:Name="ActivityText" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Border>
    <Grid Grid.Row="3" Margin="-4,0,8,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button Grid.Column="0" Content="Refresh" Click="Refresh_Click"/><Button Grid.Column="1" Content="Start" Click="Start_Click"/><Button Grid.Column="2" Content="Stop" Click="Stop_Click"/><Button Grid.Column="3" Content="Restart" Click="Restart_Click"/></Grid>
    <Border Grid.Row="4" Style="{StaticResource Card}"><StackPanel><TextBlock Text="TOOLS" Foreground="#64748B" FontWeight="SemiBold"/><WrapPanel Margin="-4,8,0,0"><Button Content="Open dashboard" Click="Dashboard_Click"/><Button Content="View logs" Click="Logs_Click"/><Button Content="Open data folder" Click="Data_Click"/></WrapPanel><TextBlock Text="Agent updates will be added in a later release." Foreground="#64748B" Margin="0,18,0,0"/></StackPanel></Border>
  </Grid>
</Window>
