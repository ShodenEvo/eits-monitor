<Window x:Class="Eits.Agent.Manager.ConnectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connection settings" Width="520" Height="430"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F4F7FB">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Reconnect this agent" FontSize="26" FontWeight="SemiBold" Foreground="#12263F"/>
        <TextBlock Grid.Row="1" Margin="0,8,0,24" Text="Enter the server and a new enrollment token." Foreground="#52606D"/>
        <Grid Grid.Row="2" Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="125"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="Server URL" VerticalAlignment="Center"/>
            <TextBox x:Name="ServerBox" Grid.Column="1" Height="36" Padding="10,7"/>
        </Grid>
        <Grid Grid.Row="3" Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="125"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="Enrollment token" VerticalAlignment="Center"/>
            <PasswordBox x:Name="TokenBox" Grid.Column="1" Height="36" Padding="10,7"/>
        </Grid>
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions><ColumnDefinition Width="125"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="Device name" VerticalAlignment="Center"/>
            <TextBox x:Name="DeviceBox" Grid.Column="1" Height="36" Padding="10,7"/>
        </Grid>
        <CheckBox x:Name="AllowHttpBox" Grid.Row="5" Margin="125,18,0,0" VerticalAlignment="Top"
                  Content="Allow insecure HTTP on a trusted network"/>
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="100" Height="38" Margin="0,0,10,0" IsCancel="True"/>
            <Button Content="Save and reconnect" Width="160" Height="38" IsDefault="True" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
