<Window x:Class="Eits.Agent.Manager.ConnectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configure uplink" Icon="Assets/eits-agent-icon.ico" Width="600" Height="620" MinHeight="620"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#071321" FontFamily="Segoe UI">
    <Grid>
        <Grid.Background><RadialGradientBrush Center="0.1,0" RadiusX="1" RadiusY="1"><GradientStop Color="#173650" Offset="0"/><GradientStop Color="#071321" Offset="0.58"/><GradientStop Color="#040B14" Offset="1"/></RadialGradientBrush></Grid.Background>
        <Border Margin="28" Style="{StaticResource CardStyle}" Padding="28">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="26"/><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="SECURE UPLINK" Style="{StaticResource SectionLabel}"/>
                    <TextBlock Text="Reconnect this node" FontSize="27" FontWeight="SemiBold" Margin="0,5,0,0"/>
                    <TextBlock Text="Authenticate this computer with an EITS Monitor server." Foreground="{StaticResource SecondaryTextBrush}" Margin="0,6,0,0"/>
                </StackPanel>
                <StackPanel Grid.Row="2"><TextBlock Text="SERVER URL" Foreground="#7894B0" FontSize="10" FontWeight="Bold" Margin="0,0,0,7"/><TextBox x:Name="ServerBox" Height="42" Style="{StaticResource TechTextBox}"/></StackPanel>
                <StackPanel Grid.Row="4"><TextBlock Text="ENROLLMENT TOKEN" Foreground="#7894B0" FontSize="10" FontWeight="Bold" Margin="0,0,0,7"/><PasswordBox x:Name="TokenBox" Height="42" Padding="12,8" FontSize="14" Foreground="#EFF8FF" Background="#101F33" BorderBrush="#3B5878" CaretBrush="#45E6D4"/></StackPanel>
                <StackPanel Grid.Row="6"><TextBlock Text="DEVICE NAME" Foreground="#7894B0" FontSize="10" FontWeight="Bold" Margin="0,0,0,7"/><TextBox x:Name="DeviceBox" Height="42" Style="{StaticResource TechTextBox}"/></StackPanel>
                <CheckBox x:Name="AllowHttpBox" Grid.Row="7" Margin="0,18,0,0" Content="Allow insecure HTTP on a trusted network" Foreground="{StaticResource SecondaryTextBrush}"/>
                <Border Grid.Row="8" Background="#0D2134" BorderBrush="#29445E" BorderThickness="1" CornerRadius="9" Padding="12" Margin="0,18,0,18" VerticalAlignment="Top"><TextBlock Text="A new identity will be issued after the server validates the enrollment token." Foreground="#79A5C8" FontSize="11" TextWrapping="Wrap"/></Border>
                <StackPanel Grid.Row="9" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Width="105" Style="{StaticResource TechButton}" IsCancel="True"/>
                    <Button Content="Connect node" Width="145" Style="{StaticResource AccentButton}" Margin="0" IsDefault="True" Click="Save_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
